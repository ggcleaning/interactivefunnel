# Environment Variables
# Copy this file to .env and fill in your actual values

# EmailJS Configuration
# Get these from https://www.emailjs.com/
VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# Google Analytics
# Get this from https://analytics.google.com/
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Stripe ──────────────────────────────────────────────────
# Get these from: https://dashboard.stripe.com/apikeys
# Use TEST keys (pk_test_... / sk_test_...) until you're ready to go live.
# IMPORTANT: VITE_ prefix exposes to browser. Secret key must NOT have VITE_ prefix.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_KEY
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY

# ─── Cloudinary (Photo Quote System) ─────────────────────────
# Free account at cloudinary.com — needed for photo uploads.
# Create an "unsigned upload preset" in Settings > Upload.
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=gg_cleaning_quotes

# ─── SMTP Email (Photo Quote Notifications) ───────────────────
# Use a Gmail App Password (NOT your regular Gmail password).
# Enable App Passwords at: myaccount.google.com/apppasswords
SMTP_USER=info@ggcleaningli.com
SMTP_APP_PASS=your_16_char_app_password_here
OWNER_EMAIL=info@ggcleaningli.com
# ─── GHL CRM Integration ──────────────────────────────
# Inbound Webhook URL from your GHL account.
# Found in: Automation > Workflows > Create Workflow > Trigger: Inbound Webhook
VITE_GHL_WEBHOOK_URL=https://services.leads.com/hooks/...
VITE_GHL_LOCATION_ID=your_ghl_location_id_here
GHL_LOCATION_ID=your_ghl_location_id_here
