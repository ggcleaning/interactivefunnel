# Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit real secret keys or .env files to Git.

# ─── Supabase Staff Auth (Phase 3A) ───────────────────────────
# Browser-safe variables (Exposed to Vite bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-only secrets (Netlify Functions ONLY — NEVER VITE_ PREFIXED)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── Legacy Secret Compatibility (Slice 3A.0.4 Cutover Complete) ───
# VITE_ADMIN_PIN=RETIRED (Supabase Staff Auth cutover completed in Slice 3A.0.4)
INTERNAL_ADMIN_SECRET=your_internal_admin_secret_here

# ─── Stripe Payment Integration ──────────────────────────────
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# ─── EmailJS & Notifications ─────────────────────────────────
VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
OWNER_EMAIL=info@ggcleaningli.com

# ─── Google & Meta Tracking ─────────────────────────────────
VITE_GA_MEASUREMENT_ID=your_ga_measurement_id_here
FB_PIXEL_ID=your_fb_pixel_id_here
FB_CAPI_ACCESS_TOKEN=your_fb_capi_token_here
VITE_CLARITY_PROJECT_ID=your_clarity_project_id_here

# ─── GHL CRM Integration ──────────────────────────────────────
GHL_LOCATION_ID=your_ghl_location_id_here
GHL_ACCESS_TOKEN=your_ghl_access_token_here
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/your_hook_id_here
